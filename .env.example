# Used by `docker compose up` and `npm run demo`. Copy to .env and edit.
# The plugin reads these from the environment; they take precedence over the settings page.

# Leave empty to use the bundled mock OpenAI server (canned copy, no key needed).
OPENAI_API_KEY=

# Docker: the mock server is the default. For real OpenAI set https://api.openai.com/v1.
# Local Ollama from Docker: http://host.docker.internal:11434/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# Mock server behavior (Docker)
MOCK_LATENCY_MS=800
MOCK_FAILURE_RATE=0
BATCH_INSERT=enabled
SAVE_STATE=enabled